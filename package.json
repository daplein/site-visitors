    "d3-geo": "^3.1.2",
    "i18n-iso-countries": "^7.14.0",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.168.0"
  }
