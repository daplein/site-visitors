{
  "name": "site-visitors",
  "version": "1.0.0",
  "private": true,
  "description": "Unique-visitor counter and public stats for daplein.github.io",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc",
    "test": "vitest run",
