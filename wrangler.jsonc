{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-visitors",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // Comma-separated origins allowed to call the API (CORS + POST /hit).
    "ALLOWED_ORIGINS": "https://daplein.github.io",
    // Pages are checked against the live site before they're first counted.
    "SITE_ORIGIN": "https://daplein.github.io",
    "CHECK_PAGES": "true"
  },
  // VISITOR_SALT is a secret: `wrangler secret put VISITOR_SALT` (and .dev.vars locally).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-visitors",
      "database_id": "81e486bf-663e-4ebb-a1bc-7f9dc19b7431",
      "migrations_dir": "migrations"
    }
  ]
}
